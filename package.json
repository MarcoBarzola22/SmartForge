{
  "name": "smartforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SmartForge MVP - Digital personal trainer PWA with auto-periodized mesocycles, fatigue auditing, and progressive overload",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:unit": "npm run test:unit --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:openapi": "redocly lint contract/openapi.yaml",
    "generate:types": "node scripts/generate-types.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@redocly/cli": "^1.17.1",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.8.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0-alpha.39",
    "yaml": "^2.4.5"
  },
  "keywords": [
    "hypertrophy",
    "strength",
    "progressive-overload",
    "pwa",
    "periodization"
  ],
  "author": "SmartForge Team",
  "license": "UNLICENSED"
}
